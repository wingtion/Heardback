{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Applications": {
    "SampleDataEnabled": true
  },
  "ClientIp": {
    "Source": "Direct"
  }
}
